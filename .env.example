# ORACLE — environment configuration
# Copy this file to .env and fill in the keys you need.
# Each key documents which Step first uses it.

# ----- LLM (Step 9+) -----
# Pick ONE of the two backends below.
#
# Backend A: OpenAI direct
#   - Set OPENAI_API_KEY only
#   - OPENAI_MODEL_* are model family names (gpt-4o, gpt-4o-mini, ...)
OPENAI_API_KEY=
OPENAI_MODEL_HEAVY=gpt-4o
OPENAI_MODEL_LIGHT=gpt-4o-mini

# Backend B: Azure AI Foundry / Azure OpenAI Service
#   - Set AZURE_OPENAI_ENDPOINT + AZURE_OPENAI_API_KEY
#   - OPENAI_MODEL_* become Azure DEPLOYMENT NAMES
#     (the names you chose when deploying models in Azure AI Foundry)
#   - When AZURE_OPENAI_ENDPOINT is set, OPENAI_API_KEY is ignored
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21

# ----- Telegram bot (Step 3 — REQUIRED to start the bot) -----
# Create via @BotFather → /newbot → copy token here
TELEGRAM_BOT_TOKEN=
# Your Telegram user ID (talk to @userinfobot to find it)
TELEGRAM_CHAT_ID=

# ----- Telegram reader for custom TG channel sources (Step 7) -----
# https://my.telegram.org → API development tools
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_NAME=oracle_reader

# ----- Market data (Step 4) -----
COINGECKO_API_KEY=
FRED_API_KEY=
PRODUCTHUNT_TOKEN=

# ----- Reddit OAuth (Step 6) -----
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# ----- YouTube Data API (Step 7) -----
YOUTUBE_API_KEY=

# ----- Observability (Step 17) -----
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# ----- Azure production (Step 19) -----
AZURE_STORAGE_CONNECTION_STRING=

# ----- Operational settings -----
TIMEZONE=Europe/Warsaw
MIN_IDEA_SCORE=70
MIN_INVESTMENT_SIGNAL=6
MAX_IDEAS_PER_DIGEST=3
MAX_INVESTMENT_SIGNALS=3
REFLEXION_MAX_ROUNDS=3
IDEA_FOCUS_WEIGHT=0.70
